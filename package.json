{
  "name": "gitagents",
  "version": "1.0.0",
  "description": "A multi-agent AI code & dependency review GitHub Action for pull requests.",
  "main": "dist/action/index.js",
  "type": "module",
  "scripts": {
    "code-quality": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.js --max-warnings=0",
    "build:action": "ncc build action/main.ts -o dist/action --source-map --license licenses.txt",
    "build:action:check": "npm run build:action && git diff --exit-code dist/action"
  },
  "keywords": [
    "github-action",
    "code-review",
    "ai",
    "pull-request",
    "dependency-review",
    "anthropic",
    "openai"
  ],
  "author": "tommyc2",
  "license": "ISC",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "@anthropic-ai/sdk": "^0.71.2",
    "dotenv": "^16.5.0",
    "js-yaml": "^4.1.1",
    "openai": "^6.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.25.9",
    "@babel/node": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.9",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^8.57.1",
    "typescript": "^5.9.3"
  }
}
